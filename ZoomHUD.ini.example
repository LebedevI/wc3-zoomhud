; ZoomHUD.ini — настройки мода зума (читается при запуске игры)
[ZoomHUD]
; шаг изменения зума (единицы дистанции камеры)
Step=100
; границы
Min=150
Max=4050
; стартовое значение при запуске игры
Start=2350
; клавиши (Virtual-Key коды): 33=PageUp 34=PageDown 35=End 45=Insert
KeyUp=33
KeyDown=34
KeyHold=35
KeyHud=45
; 1 = не отдавать эти клавиши игре (иначе она использует их для прокрутки камеры)
SwallowKeys=1
; размер шрифта HUD (7..40)
Font=12
; шрифт HUD (Georgia — с засечками, как в Reforged)
FontFace=Georgia
; единый цвет всего HUD (R,G,B); по умолчанию как у зума
ColorR=255
ColorG=225
ColorB=120
; позиция HUD в пикселях (0,0 — самый левый верхний угол)
X=8
Y=30
; 1 = держать зум постоянно (переприменять раз в 0.5 с)
Hold=0
; 1 = включать удержание автоматически, если игра сбросила камеру
AutoHold=0
; 1 = показывать фактическое значение, если оно отличается от заданного
ShowReal=1
; --- APM и пинг рядом с зумом ---
ShowApm=1
DebugAct=0
; 1 = писать в лог Sleep из Game.dll (поиск ограничителя FPS)
DebugSleep=0
ShowPing=1
; 1 = показывать таймер справа от FPS (стартует со входом в игру)
ShowTimer=1
; отступ от числа зума в пикселях (9 см это примерно 340 px при 96 DPI)
Gap=105
; вертикальная позиция блока APM/пинг (-1 = как у зума)
Y2=30
; как часто мерить пинг, мс
PingEvery=2000
; резервный адрес для пинга, если у игры нет TCP-соединения (пусто = показывать --)
PingHost=8.8.8.8
